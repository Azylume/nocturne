<?xml version="1.0" encoding="UTF-8"?>
<!-- Entitlements for the ad-hoc signed preview bundle (tools/make-bundle.sh). The engine captures audio to react to
     the music, listens on a loopback control socket, and the UI connects to it; nothing here opens the machine to the
     network beyond that. A signed, notarised build (#32) revisits these. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
