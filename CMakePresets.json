{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (host architecture)",
      "description": "Ninja, the host architecture only; ccache is used when installed.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "" }
    },
    {
      "name": "universal",
      "displayName": "Universal (arm64 + x86_64)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-universal",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" }
    },
    {
      "name": "sanitize",
      "displayName": "ASan + UBSan (host architecture)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": { "NOCTURNE_SANITIZE": "ON" }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer harnesses (host architecture)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": { "NOCTURNE_FUZZ": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "universal", "configurePreset": "universal" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "fuzz", "configurePreset": "fuzz", "targets": ["fuzz"] }
  ]
}
